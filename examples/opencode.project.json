{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "typescript": {
      "disabled": true
    },
    "arkts-lsp": {
      "command": [
        "npx",
        "--yes",
        "--registry",
        "https://registry.npmjs.org/",
        "@fe-essential/arkts-lsp"
      ],
      "extensions": [
        ".ets",
        ".ts"
      ],
      "initialization": {
        "projectMarkers": [
          "AppScope/app.json5",
          "hvigorfile.ts",
          "build-profile.json5",
          "oh-package.json5"
        ]
      }
    }
  }
}
